<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="u.nus.edu.astar.demo">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    
    <!-- ⭐ 新增：允许应用在设备启动时自动启动 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- ⭐ 新增：允许应用保持唤醒状态 -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    
    <!-- ⭐ 新增：电池优化豁免请求权限 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- ⭐ 新增：精确闹钟权限（用于 AlarmManager） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>

    <!-- 可按需保留，如果 target >= 33 且不再需要外部存储可移除 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:label="LPT"
        tools:replace="android:label"
        android:foregroundServiceType="location"
        android:enableOnBackInvokedCallback="false"
        android:usesCleartextTraffic="false">

        <!-- ⭐ Transistorsoft background-geolocation 核心服务 -->
        <!-- 注意：只需要声明 TrackingService，其他组件由插件自动注入 -->
        <service
            android:name="com.transistorsoft.locationmanager.service.TrackingService"
            android:foregroundServiceType="location"
            android:exported="false" />
        <service
            android:name="com.transistorsoft.locationmanager.service.LocationRequestService"
            android:foregroundServiceType="location"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />
            
        <!-- 许可证 -->
        <meta-data
            android:name="com.transistorsoft.locationmanager.license"
            android:value="c56ffbe8b7be9e046c996511423cd70a07f921f9a2d3acca0272dbe60265cb58" />

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyD_3HhIVBjQwZYrUI-AqgA5c7_I8zNZ9Fo" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:hardwareAccelerated="true"
            android:theme="@style/LaunchTheme"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.braintreepayments.api.BraintreeBrowserSwitchActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}.braintree" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"/>

        <!-- ⭐ 重要说明：不要手动声明 BootReceiver、AlarmReceiver、GeofenceBroadcastReceiver -->
        <!-- flutter_background_geolocation 插件会通过 Gradle 自动注入这些组件 -->
        <!-- 手动声明会导致 ClassNotFoundException 崩溃 -->

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <meta-data
            android:name="com.onesignal.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_onesignal_default" />
    </application>
</manifest>